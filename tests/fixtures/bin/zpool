#!/bin/sh

if [ "$1" = "list" ]; then
	if [ "${ZFSM_TEST_POOL_FAIL:-0}" = 1 ]; then
		printf 'simulated pool query failure\n' >&2
		exit 1
	fi
	printf 'tank\t1.00T\t100G\t900G\tONLINE\n'
	exit 0
fi

if [ "$1" = "status" ]; then
	cat <<'EOF'
  pool: tank
 state: ONLINE
config:

	NAME        STATE     READ WRITE CKSUM
	tank        ONLINE       0     0     0
	  mirror-0  ONLINE       0     0     0
	    sda     ONLINE       0     0     0
	    sdb     ONLINE       0     0     0

errors: No known data errors
EOF
	exit 0
fi

exit 1
